# Copiar este archivo como .env y completar la clave pública de Junar.
# No subir .env a Git.
ESPARZA_API_KEY=""

# Normalmente no hace falta cambiar esto.
JUNAR_BASE_URL="http://api.datosabiertos.muniesparza.go.cr/api/v2"
JUNAR_REFERER="https://datosabiertos.muniesparza.go.cr/developers/"

# Ritmo conservador. La documentación de Junar indica 5 req/s como umbral de bloqueo.
# Este kit usa 1 req/s por defecto para no cargar innecesariamente el portal.
REQUESTS_PER_SECOND="1"
REQUEST_TIMEOUT_SECONDS="45"
